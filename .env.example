# Server
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info
LOG_FORMAT=pretty          # pretty | json (pretty uses pino-pretty transport)
LOG_FILE=                 # path to log file (empty = stdout)

# Service
SERVICE_NAME=my-service
GATEWAY_URL=              # URL of the gateway (for registration)

# CORS
CORS_ORIGIN=true          # true | false | comma-separated origins (e.g. http://app.local,https://app.com)

# Internal Call Header
INTERNAL_CALL_HEADER=x-internal-call

# API Prefix
# API_PREFIX=/api/v2      # API prefix for all routes (e.g., /api/v2/health)
